  "name": "A11oy Holo-Constellation",
  "purpose": "One governed experience system with a distinct visual instrument for every SZL product, proof surface, and application Space.",
  "inspiration_principles": {
    "editorial_clarity": "Large human-readable typography, calm hierarchy, generous whitespace, and precise language.",
    "orbital_depth": "Cinematic spatial composition, orbital paths, mission-control framing, and disciplined darkness.",
    "performance_materiality": "GPU-grade dimensional surfaces, specular light, depth cues, and fast progressive enhancement.",
    "observability_legibility": "Dense operational information organized by signal, state, confidence, evidence, and action.",
    "agentic_workflows": "Visible handoffs between human and machine actors without implying unmeasured autonomy.",
    "premium_storytelling": "Strong product narrative, modular sections, and polished transitions without decorative overload."
  },
  "originality_boundary": [
    "No copied source code, graphics, trademarks, layouts, illustrations, motion sequences, or proprietary assets.",
    "Reference companies inform design principles only; all implementation, motifs, tokens, copy, and components are SZL-original.",
    "Decorative motion is labeled and never presented as measured telemetry.",
    "Operational claims remain bound to measured evidence and existing honesty contracts."
  ],
  "shared_contract": {
    "minimum_touch_target_px": 44,
    "supported_viewports_px": [320, 360, 390, 768, 1024, 1440, 1920],
    "reduced_motion": "required",
    "forced_colors": "required",
    "prefers_contrast": "required",
    "keyboard_navigation": "required",
    "safe_area_support": "required",
    "horizontal_overflow": "forbidden",
    "third_party_runtime_assets": "forbidden",
    "analytics_or_tracking": "not included",
    "progressive_enhancement": "CSS first; Canvas enhancement optional; content remains usable without animation",
    "performance_budget": {
      "core_css_gzip_kb_max": 24,
      "core_js_gzip_kb_max": 18,
      "long_task_ms_max": 50,
      "animation_fps_target": 60,
      "animation_fps_low_power": 30,
      "continuous_animation_layers_max": 3
    }
  },
