  "scripts": {
    "test": "node src/receipt_substrate.test.ts && node --test src/research_evidence.test.ts src/canonical_proto.test.ts src/canonical_jcs.test.ts src/merkle_log.test.ts src/checkpoint.test.ts",
    "test:serve": "node --test src/serve.test.ts",
    "test:jsonld": "node --test ../../src/jsonld/dsse_verify.test.ts ../../src/jsonld/vc_data_integrity.test.ts ../../src/sigstore/rekor_merkle.test.ts",
