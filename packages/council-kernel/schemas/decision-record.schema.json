{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a11oy:council:decision-record:v1",
  "title": "A11oy Council decision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_digest",
    "decision",
    "score",
    "reasons",
    "grant_id",
    "diversity",
    "member_results",
    "minority_reports",
    "decision_digest"
  ],
  "properties": {
    "proposal_digest": { "$ref": "#/$defs/sha256" },
    "decision": { "$ref": "#/$defs/decision" },
    "score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "grant_id": {
      "oneOf": [
        { "$ref": "#/$defs/nonempty" },
        { "type": "null" }
      ]
    },
    "diversity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_size", "member_weights", "unique_values_by_axis"],
      "properties": {
        "effective_size": {
          "type": "number",
          "minimum": 0
        },
        "member_weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "unique_values_by_axis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator_id",
            "key_id",
            "model_lineage",
            "implementation_id",
            "provider_id",
            "retrieval_path",
            "evidence_domain",
            "trust_domain"
          ],
          "properties": {
            "operator_id": { "type": "integer", "minimum": 0 },
            "key_id": { "type": "integer", "minimum": 0 },
            "model_lineage": { "type": "integer", "minimum": 0 },
            "implementation_id": { "type": "integer", "minimum": 0 },
            "provider_id": { "type": "integer", "minimum": 0 },
            "retrieval_path": { "type": "integer", "minimum": 0 },
            "evidence_domain": { "type": "integer", "minimum": 0 },
            "trust_domain": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "member_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/member_result" }
    },
    "minority_reports": {
      "type": "array",
      "items": { "$ref": "#/$defs/minority_report" }
    },
    "decision_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "role": {
      "type": "string",
      "enum": ["AUTHORITY", "SENTINEL", "VERIFIER", "VALUE"]
    },
    "decision": {
      "type": "string",
      "enum": ["ACT", "ESCALATE", "BLOCK"]
    },
    "member_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_id",
        "role",
        "recommendation",
        "confidence",
        "veto",
        "evidence",
        "objections"
      ],
      "properties": {
        "member_id": { "$ref": "#/$defs/nonempty" },
        "role": { "$ref": "#/$defs/role" },
        "recommendation": { "$ref": "#/$defs/decision" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "veto": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonempty" }
        },
        "objections": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonempty" }
        }
      }
    },
    "minority_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "role", "recommendation", "objections", "evidence"],
      "properties": {
        "member_id": { "$ref": "#/$defs/nonempty" },
        "role": { "$ref": "#/$defs/role" },
        "recommendation": { "$ref": "#/$defs/decision" },
        "objections": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonempty" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonempty" }
        }
      }
    }
  }
}
