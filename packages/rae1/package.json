{
  "name": "@szl-holdings/rae1",
  "version": "1.0.0",
  "description": "RAE-1 (Receipt-Attested Evaluation) protocol implementation — DSSE schema, chain integrity, HMAC verification gates. SZL Holdings.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js"
    },
    "./chain": {
      "types": "./dist/chain.d.ts",
      "import": "./dist/chain.js"
    },
    "./hmac": {
      "types": "./dist/hmac.d.ts",
      "import": "./dist/hmac.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/**/*.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test:package": "node scripts/test-packed.mjs"
  },
  "keywords": [
    "rae1",
    "dsse",
    "receipt-attestation",
    "benchmark",
    "pac-bayes",
    "lean4",
    "szl-holdings",
    "cryptographic-attestation"
  ],
  "author": "SZL Holdings <eng@szl-holdings.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "vitest": "4.1.11",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
