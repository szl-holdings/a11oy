{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-11-oy.com/schemas/workspace-disposition-v1.json",
  "title": "Workspace Disposition Receipt v1",
  "description": "Carries bounded behavioral-proxy measurements for what a governed inference route verbalized or withheld alongside its output. It is not evidence of a hidden internal workspace or chain of thought. Labels are never upgraded; directed modulation, internal reasoning, and generalization remain UNAVAILABLE.",
  "type": "object",
  "required": [
    "schema",
    "inference_receipt_id",
    "bound_route",
    "workspace_disposition"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "szl.workspace-disposition/v1"
    },
    "inference_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "bound_route": {
      "type": "object",
      "required": [
        "model_revision",
        "tokenizer_revision"
      ],
      "additionalProperties": false,
      "properties": {
        "model_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tokenizer_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "workspace_disposition": {
      "type": "object",
      "required": [
        "label",
        "claim_boundary",
        "reportability",
        "selectivity",
        "directed_modulation",
        "internal_reasoning",
        "generalization"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "enum": [
            "MEASURED",
            "MODELED",
            "UNAVAILABLE"
          ]
        },
        "claim_boundary": {
          "const": "BEHAVIORAL_PROXY_ONLY"
        },
        "reportability": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "state",
                "verbalizable_fraction"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "MEASURED"
                },
                "verbalizable_fraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "state",
                "verbalizable_fraction"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "UNAVAILABLE"
                },
                "verbalizable_fraction": {
                  "const": null
                }
              }
            }
          ]
        },
        "selectivity": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "state",
                "workspace_variance_fraction"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "MEASURED"
                },
                "workspace_variance_fraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "state",
                "workspace_variance_fraction"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "UNAVAILABLE"
                },
                "workspace_variance_fraction": {
                  "const": null
                }
              }
            }
          ]
        },
        "directed_modulation": {
          "const": "UNAVAILABLE"
        },
        "internal_reasoning": {
          "const": "UNAVAILABLE"
        },
        "generalization": {
          "const": "UNAVAILABLE"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "const": "UNAVAILABLE"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "properties": {
              "reportability": {
                "properties": {
                  "state": {
                    "const": "UNAVAILABLE"
                  }
                }
              },
              "selectivity": {
                "properties": {
                  "state": {
                    "const": "UNAVAILABLE"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "enum": [
                  "MEASURED",
                  "MODELED"
                ]
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "reportability": {
                    "properties": {
                      "state": {
                        "const": "MEASURED"
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "selectivity": {
                    "properties": {
                      "state": {
                        "const": "MEASURED"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
