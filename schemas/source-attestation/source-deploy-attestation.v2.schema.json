{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-11-oy.com/schemas/source-deploy-attestation.v2.schema.json",
  "title": "SZL Source and Deploy Attestation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "immutable_for_process", "repository_url", "source_commit", "deployed_commit", "build_digest", "image_digest", "deploy_timestamp", "deployment_target", "alignment_state", "claims", "limits"],
  "properties": {
    "schema_version": {"const": "szl.source-deploy-attestation/v2"},
    "immutable_for_process": {"const": true},
    "repository_url": {"type": "string", "format": "uri"},
    "source_commit": {"$ref": "#/$defs/observedCommit"},
    "deployed_commit": {"$ref": "#/$defs/observedCommit"},
    "build_digest": {"$ref": "#/$defs/observedDigest"},
    "image_digest": {"$ref": "#/$defs/observedDigest"},
    "deploy_timestamp": {"$ref": "#/$defs/observedTimestamp"},
    "deployment_target": {"type": "string", "minLength": 1},
    "alignment_state": {"enum": ["MATCH", "CONFLICT", "UNKNOWN"]},
    "claims": {"type": "object", "additionalProperties": {"type": "string"}},
    "limits": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidence": {
      "description": "MEASURED is reserved for an independent observation and is not produced by szl_source_attestation.py. Commit slots do not accept MEASURED. A MEASURED build digest, image digest, or deploy timestamp must use measurement_method INDEPENDENT_ARTIFACT_OBSERVATION: a party who did not supply the string compared it to artifact bytes or a signed time outside this process. SPACE_REPOSITORY_COMMIT is not a method for those slots. It names the separate hf-revision observation in which a party who did not write the binding file compared running bytes to the published git object. ENV_DECLARATION and CALLER_DECLARED are declarations and do not carry a measurement method.",
      "type": "object", "additionalProperties": false, "required": ["value", "evidence_class"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "evidence_class": {"enum": ["MEASURED", "UNKNOWN", "ENV_DECLARATION", "CALLER_DECLARED"]},
        "measurement_method": {"type": "string", "minLength": 1}
      },
      "allOf": [{
        "if": {"properties": {"evidence_class": {"const": "MEASURED"}}, "required": ["evidence_class"]},
        "then": {"required": ["measurement_method"]}
      }]
    },
    "observedCommit": {"allOf": [
      {"$ref": "#/$defs/evidence"},
      {"properties": {"value": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}}},
      {"if": {"properties": {"evidence_class": {"const": "MEASURED"}}, "required": ["evidence_class"]}, "then": false}
    ]},
    "observedDigest": {"allOf": [
      {"$ref": "#/$defs/evidence"},
      {"properties": {"value": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}}},
      {"if": {"properties": {"evidence_class": {"const": "MEASURED"}}, "required": ["evidence_class"]}, "then": {"properties": {"measurement_method": {"const": "INDEPENDENT_ARTIFACT_OBSERVATION"}}}}
    ]},
    "observedTimestamp": {"allOf": [
      {"$ref": "#/$defs/evidence"},
      {"properties": {"value": {"type": ["string", "null"], "format": "date-time"}}},
      {"if": {"properties": {"evidence_class": {"const": "MEASURED"}}, "required": ["evidence_class"]}, "then": {"properties": {"measurement_method": {"const": "INDEPENDENT_ARTIFACT_OBSERVATION"}}}}
    ]}
  }
}
