{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-11-oy.com/schemas/oro/v1/codex.schema.json",
  "title": "ORO signed data-only Codex v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "codex_id", "version", "invariants"],
  "properties": {
    "schema": {"const": "szl.oro-codex/v1"},
    "codex_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invariant_id",
          "version",
          "source_blob_digest",
          "implementation_digest",
          "input_schema",
          "golden_vectors_digest",
          "blocking"
        ],
        "properties": {
          "invariant_id": {"type": "string", "minLength": 1, "maxLength": 512},
          "version": {"type": "string", "minLength": 1, "maxLength": 64},
          "source_blob_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "implementation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "input_schema": {"type": "string", "minLength": 1, "maxLength": 512},
          "golden_vectors_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "blocking": {"type": "boolean"}
        }
      }
    }
  }
}
