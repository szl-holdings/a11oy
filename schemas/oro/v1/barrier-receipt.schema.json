{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-11-oy.com/schemas/oro/v1/barrier-receipt.schema.json",
  "title": "ORO barrier receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "barrier_id",
    "orbit_id",
    "generation",
    "generated_at",
    "expires_at",
    "decision",
    "reason",
    "semantic_hash",
    "rank_before",
    "rank_after",
    "rank_version",
    "objective_converged",
    "codex",
    "codex_digest",
    "allocation_receipt",
    "lineage",
    "theorem_binding",
    "invariant_results",
    "participants",
    "derived_descendants_valid",
    "receipt_digest"
  ],
  "properties": {
    "schema": {"const": "szl.oro-barrier-receipt/v1"},
    "barrier_id": {"type": "string", "minLength": 1},
    "orbit_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 0},
    "generated_at": {"type": "string", "pattern": "Z$"},
    "expires_at": {"type": "string", "pattern": "Z$"},
    "decision": {"enum": ["CONTINUE", "COMPLETE", "REFUSE"]},
    "reason": {"type": "string", "minLength": 1},
    "semantic_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rank_before": {"$ref": "rank.schema.json"},
    "rank_after": {"$ref": "rank.schema.json"},
    "rank_version": {"const": "szl.oro-rank/v1"},
    "objective_converged": {"type": "boolean"},
    "codex": {"$ref": "codex.schema.json"},
    "codex_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "allocation_receipt": {"type": ["object", "null"]},
    "lineage": {"type": "object"},
    "theorem_binding": {"type": ["object", "null"]},
    "invariant_results": {"type": "array", "items": {"type": "object"}},
    "participants": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "derived_descendants_valid": {"type": "boolean"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
