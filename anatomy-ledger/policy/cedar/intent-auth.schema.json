{
  "A11oy": {
    "commonTypes": {
      "IntentContext": {
        "type": "Record",
        "attributes": {
          "evidenceDigest": {
            "type": "String"
          },
          "humanApproval": {
            "type": "Bool"
          },
          "intendedEffect": {
            "type": "String"
          },
          "mfa": {
            "type": "Bool"
          },
          "networkZone": {
            "type": "String"
          },
          "purpose": {
            "type": "String"
          },
          "requestId": {
            "type": "String"
          },
          "riskScore": {
            "type": "Long"
          },
          "sessionId": {
            "type": "String"
          },
          "timestamp": {
            "type": "String"
          },
          "traceId": {
            "type": "String"
          }
        }
      }
    },
    "entityTypes": {
      "ProtectedResource": {
        "shape": {
          "type": "Record",
          "attributes": {
            "allowedEffects": {
              "type": "Set",
              "element": {
                "type": "String"
              }
            },
            "allowedPurposes": {
              "type": "Set",
              "element": {
                "type": "String"
              }
            },
            "classification": {
              "type": "Long"
            },
            "kind": {
              "type": "String"
            },
            "maxRisk": {
              "type": "Long"
            },
            "requiredAssurance": {
              "type": "Long"
            },
            "requiresApproval": {
              "type": "Bool"
            },
            "tenantId": {
              "type": "String"
            }
          }
        }
      },
      "WorkloadIdentity": {
        "shape": {
          "type": "Record",
          "attributes": {
            "assurance": {
              "type": "Long"
            },
            "disabled": {
              "type": "Bool"
            },
            "kind": {
              "type": "String"
            },
            "roles": {
              "type": "Set",
              "element": {
                "type": "String"
              }
            },
            "tenantId": {
              "type": "String"
            }
          }
        }
      }
    },
    "actions": {
      "AdministerPolicy": {
        "appliesTo": {
          "resourceTypes": [
            "A11oy::ProtectedResource"
          ],
          "principalTypes": [
            "A11oy::WorkloadIdentity"
          ],
          "context": {
            "type": "A11oy::IntentContext"
          }
        }
      },
      "ApproveDecision": {
        "appliesTo": {
          "resourceTypes": [
            "A11oy::ProtectedResource"
          ],
          "principalTypes": [
            "A11oy::WorkloadIdentity"
          ],
          "context": {
            "type": "A11oy::IntentContext"
          }
        }
      },
      "DeployArtifact": {
        "appliesTo": {
          "resourceTypes": [
            "A11oy::ProtectedResource"
          ],
          "principalTypes": [
            "A11oy::WorkloadIdentity"
          ],
          "context": {
            "type": "A11oy::IntentContext"
          }
        }
      },
      "ExportEvidence": {
        "appliesTo": {
          "resourceTypes": [
            "A11oy::ProtectedResource"
          ],
          "principalTypes": [
            "A11oy::WorkloadIdentity"
          ],
          "context": {
            "type": "A11oy::IntentContext"
          }
        }
      },
      "InvokeTool": {
        "appliesTo": {
          "resourceTypes": [
            "A11oy::ProtectedResource"
          ],
          "principalTypes": [
            "A11oy::WorkloadIdentity"
          ],
          "context": {
            "type": "A11oy::IntentContext"
          }
        }
      },
      "ReadResource": {
        "appliesTo": {
          "resourceTypes": [
            "A11oy::ProtectedResource"
          ],
          "principalTypes": [
            "A11oy::WorkloadIdentity"
          ],
          "context": {
            "type": "A11oy::IntentContext"
          }
        }
      },
      "SignReceipt": {
        "appliesTo": {
          "resourceTypes": [
            "A11oy::ProtectedResource"
          ],
          "principalTypes": [
            "A11oy::WorkloadIdentity"
          ],
          "context": {
            "type": "A11oy::IntentContext"
          }
        }
      },
      "WriteResource": {
        "appliesTo": {
          "resourceTypes": [
            "A11oy::ProtectedResource"
          ],
          "principalTypes": [
            "A11oy::WorkloadIdentity"
          ],
          "context": {
            "type": "A11oy::IntentContext"
          }
        }
      }
    }
