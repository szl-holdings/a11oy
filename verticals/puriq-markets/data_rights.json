{
  "customer_data": {
    "excluded_from_training_by_default": true,
    "export_and_deletion_supported": true,
    "logs_and_receipts_minimized": true,
    "tenant_scoped": true
  },
  "default_training_use": "PROHIBITED",
  "private_sources": [
    "customer risk register",
    "treasury/exposure data",
    "business scenario assumptions",
    "committee policy and decision records"
  ],
  "public_sources": [
    "Polymarket Gamma/CLOB market metadata and history",
    "Metaculus public forecast and resolution data where permitted",
    "Kalshi or other regulated event-contract public data where accessible and licensed",
    "Federal Reserve, BLS, Treasury, SEC and other official macro/filing data"
  ],
  "schema": "szl.data-rights-contract/v8",
  "source_requirements": [
    "owner and authoritative URL",
    "license or contract",
    "permitted purpose",
    "territory and user scope",
    "collection method and rate limits",
    "display and redistribution",
    "retention and deletion",
    "correction and revocation",
    "training/evaluation permission",
    "source revision and freshness"
  ],
  "vertical_id": "puriq-markets"
}
