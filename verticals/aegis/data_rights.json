{
  "customer_data": {
    "excluded_from_training_by_default": true,
    "export_and_deletion_supported": true,
    "logs_and_receipts_minimized": true,
    "tenant_scoped": true
  },
  "default_training_use": "PROHIBITED",
  "private_sources": [
    "Entra/Defender or Okta",
    "AWS, Azure and GCP asset/configuration graphs",
    "Wiz, CrowdStrike or other admitted defensive platform",
    "GitHub",
    "ServiceNow or Jira",
    "CMDB and business-criticality registry"
  ],
  "public_sources": [
    "CISA KEV",
    "NVD 2.0",
    "MITRE ATT&CK STIX 2.1/TAXII",
    "OCSF synthetic and public security events"
  ],
  "schema": "szl.data-rights-contract/v8",
  "source_requirements": [
    "owner and authoritative URL",
    "license or contract",
    "permitted purpose",
    "territory and user scope",
    "collection method and rate limits",
    "display and redistribution",
    "retention and deletion",
    "correction and revocation",
    "training/evaluation permission",
    "source revision and freshness"
  ],
  "vertical_id": "aegis"
}
