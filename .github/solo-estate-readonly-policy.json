      "kernel",
      "council-kernel",
      "alloy-kernel",
      "state-kernel",
      "proof-kernel"
    ]
  },
  "truth_labels": {
    "PROVED": "Derived from exact source or deterministic validation.",
    "MEASURED": "Observed from a named current provider API or runtime readback.",
    "BLOCKED": "A required authority or evidence source is unavailable or failing.",
    "NOT_CLAIMED": "No production, security, legal, or deployment conclusion is inferred without evidence."
  }
