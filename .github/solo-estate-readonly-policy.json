      "dependabot": [
        ".github/dependabot.yml",
        ".github/dependabot.yaml"
      ],
      "codeql": [
        ".github/workflows/codeql.yml",
        ".github/workflows/codeql.yaml"
      ],
      "secret_scanning": [
        ".github/workflows/gitleaks.yml",
        ".github/workflows/gitleaks.yaml"
      ],
      "security_policy": [
        "SECURITY.md",
        ".github/SECURITY.md"
      ],
      "codeowners": [
        ".github/CODEOWNERS",
        "CODEOWNERS"
      ]
    }
  },
  "issue_inventory": {
