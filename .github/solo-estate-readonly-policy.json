      "deployment": [
        "deploy",
        "production",
        "runtime",
        "readiness",
        "drift",
        "relock",
        "rollback",
        "incident",
        "outage"
      ],
      "p0": [
        "critical",
        "secret leak",
        "credential leak",
        "data loss",
        "outage",
        "compromise",
        "production down"
      ],
      "p1": [
        "failing",
        "blocked",
        "drift",
        "deployment",
        "production",
        "readiness",
        "security"
      ],
      "external": [
        "external blocker",
        "provider blocker",
        "permission denied",
        "bad credentials",
        "legal review",
        "license unknown"
      ],
      "major_upgrade": [
        "major upgrade",
        "breaking change",
        "vite 8",
        "node 24"
