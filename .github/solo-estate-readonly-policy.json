    "maximum_markdown_table_columns": 6,
    "required_sections": {
      "model": [
        "overview",
        "status",
        "usage",
        "limitations"
      ],
      "dataset": [
        "overview",
        "data",
        "license",
        "limitations"
      ],
      "space": [
        "overview",
        "status",
        "evidence",
        "usage"
      ],
      "kernel": [
        "overview",
        "contract",
        "status",
        "evidence"
      ]
